{
  "name": "junrui-site",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && npm run check:content && astro build",
    "preview": "astro preview",
    "test": "vitest run --passWithNoTests",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "check:links": "linkinator dist --recurse --skip '^https?://(?!127\\.0\\.0\\.1:)'",
    "check:links:external": "linkinator dist --recurse",
    "lighthouse": "lhci autorun",
    "verify": "npm run build && npm test && npm run test:dist && npm run check:links && npm run lighthouse",
    "check:content": "node scripts/check-content.ts",
    "sync:bank": "node --env-file-if-exists=.env.local scripts/sync-bank.ts",
    "sync:resume": "node --env-file-if-exists=.env.local scripts/sync-resume.ts",
    "fonts:subset": "npm run build && node scripts/subset-fonts.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.7",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@lhci/cli": "0.16.0",
    "fast-xml-parser": "5.12.0",
    "linkinator": "8.1.0",
    "node-html-parser": "9.0.7",
    "playwright-core": "1.65.0",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
