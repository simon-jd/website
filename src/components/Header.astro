---
// The "jd." wordmark, mono navigation and the résumé pill (mockup lines 51–56,
// 131–133). On phones every link stays visible; there is no menu.
import { NAV, SITE } from '../lib/site.ts';

interface Props {
  ruled?: boolean;
}

const { ruled = false } = Astro.props;
const path = Astro.url.pathname;
/** `page` on the section's own index, `true` inside it (a case study under /work/). */
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class:list={['site-header', { ruled }]}>
  <div class="wrap bar">
    <a class="wordmark" href="/">jd<span class="dot">.</span><span class="visually-hidden">{` ${SITE.title}, home`}</span></a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a class="cv" href="/resume.pdf">résumé{' '}<span aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --nav-size: 14px;
    --nav-gap: 28px;
    position: relative;
    z-index: 2;
  }

  .ruled {
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px var(--nav-gap);
    padding-block: 26px;
  }

  .wordmark {
    /* The mockup has italic 500, but only the 400 italic face ships. */
    font: italic 400 36px/1 var(--font-display);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .dot {
    color: var(--accent);
  }

  nav {
    margin-left: auto;
    color: var(--muted);
    font: var(--nav-size)/1.4 var(--font-mono);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--nav-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    text-decoration-color: transparent;
  }

  nav a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  /* The current section in ink and underlined, so it differs by more than color, as the
     writing filters mark theirs. Longhands only: Safari before 26.2 drops a shorthand
     that holds var() or a thickness. */
  nav a[aria-current] {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-color: currentColor;
  }

  .cv {
    display: inline-block;
    text-decoration: none;
    padding: 6px 14px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
  }

  nav .cv:hover {
    background: var(--ink);
    color: var(--bg);
  }

  @media (width <= 640px) {
    .site-header {
      --nav-size: 13px;
      --nav-gap: 14px;
    }

    .bar {
      padding-block: 16px;
    }

    .wordmark {
      font-size: 30px;
    }
  }

  /* Keeps the whole header on one row down to 320px. */
  @media (width < 380px) {
    .site-header {
      --nav-size: 12px;
      --nav-gap: 12px;
    }

    .cv {
      padding: 5px 11px;
    }
  }
</style>
