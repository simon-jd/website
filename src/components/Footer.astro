---
import { profile } from '../lib/site.ts';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: profile.github, label: 'github' },
  { href: profile.linkedin, label: 'linkedin' },
  { href: `mailto:${profile.email}`, label: 'email' },
  { href: '/rss.xml', label: 'rss' },
];
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="row">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
    <p class="colophon">Set in Cormorant Garamond, Inter and JetBrains Mono. Built with Astro.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: 56px;
    border-top: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 28px 40px;
  }

  .row,
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
  }

  .row {
    color: var(--muted);
    font: 13px/1.6 var(--font-mono);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a:hover {
    color: var(--ink);
  }

  .colophon {
    margin: 0;
    color: var(--muted);
    font: italic 400 17px/1.4 var(--font-display);
  }
</style>
