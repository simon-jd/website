---
// A row of key numbers (mockup lines 76–82; stacked on phones, 138–142). The values
// arrive as props: from the allowlist on the home page and from MDX in articles, and
// check:content ties both to the bank.
interface Props {
  items: { value: string; label: string }[];
  caption?: string;
}

const { items, caption } = Astro.props;
---

<figure class="stats">
  <ul>
    {
      items.map((item) => (
        <li>
          <span class="value">{item.value}</span>{' '}<span class="label">{item.label}</span>
        </li>
      ))
    }
  </ul>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .stats {
    margin: 0;
  }

  ul {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
    list-style: none;
  }

  li {
    position: relative;
    padding: 18px 0 20px;
  }

  li + li {
    padding-left: 28px;
    border-left: 1px solid var(--line);
  }

  li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 28px;
    height: 2px;
    background: var(--accent);
  }

  li + li::before {
    left: 28px;
  }

  .value {
    display: block;
    font: 500 40px/1.05 var(--font-display);
  }

  .label {
    color: var(--muted);
    font-size: 13.5px;
  }

  figcaption {
    margin-top: 10px;
    color: var(--muted);
    font: 12px/1.5 var(--font-mono);
  }

  @media (width <= 640px) {
    ul {
      grid-auto-flow: row;
    }

    li {
      padding-block: 14px;
    }

    li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    li + li::before {
      left: 0;
    }

    .value {
      font-size: 34px;
    }
  }
</style>
